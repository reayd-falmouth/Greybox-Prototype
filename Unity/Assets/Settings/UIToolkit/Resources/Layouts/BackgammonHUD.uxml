        <ui:VisualElement name="ModalLayer" class="modal-layer" style="display: none;">
            <ui:VisualElement name="ModalBackdrop" class="modal-backdrop">
                <ui:VisualElement name="ModalCard" class="modal-card" style="width: 1189px; max-width: 1233px; max-height: 1000px; height: 850px; display: flex;">
                    <ui:ScrollView name="ModalBody" class="modal-body">
                        <ui:VisualElement name="SettingsContent" class="modal-content" style="display: none;">
                            <ui:VisualElement name="TabNavigation" class="modal-tab-navigation" style="justify-content: center; align-self: center; align-content: center; max-width: 100%; width: 100%; height: 92px;">
                                <ui:Button text="Game" name="GameTabButton" class="modal-tab-button modal-tab-button-active"/>
