        <ui:VisualElement name="LobbyLayer" class="lobby-layer" style="background-color: rgb(10, 19, 25); align-self: center; background-image: url(&quot;project://database/Assets/Art/Textures/I_want_animate_this_I_202605131141.jpeg?fileID=2800000&amp;guid=c2ec0117c3528f44d97ca7bcbf940cf3&amp;type=3#I_want_animate_this_I_202605131141&quot;); display: flex;">
            <ui:VisualElement name="LobbyIcon" class="lobby-icon" style="background-image: url(&quot;project://database/Assets/Art/Textures/Poker_chips_falling_like_rain_202605131156.jpeg?fileID=2800000&amp;guid=0d5b30c3dd09de9408dbb0623057975d&amp;type=3#Poker_chips_falling_like_rain_202605131156&quot;); align-self: center; justify-content: space-between; height: 100%; width: 100%; margin-bottom: 0; max-height: 100%; display: none;"/>
            <ui:VisualElement name="LobbyCard" class="lobby-card" style="flex-direction: row; width: 100%; display: flex; position: absolute; height: 180px; bottom: 45px; background-color: rgba(10, 20, 26, 0.4); align-self: center; align-content: center;">
                <ui:VisualElement name="LobbyButtonGroup" class="lobby-button-group" style="flex-direction: row; align-self: center; position: absolute; display: flex; width: 804px; justify-content: center; align-content: center;">
