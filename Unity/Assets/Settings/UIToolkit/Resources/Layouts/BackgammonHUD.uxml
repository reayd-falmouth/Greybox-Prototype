                    <ui:Button name="LobbyOptionsButton" text="SETTINGS" class="rounded-button-large lobby-button m16font button-secondary" style="-unity-text-align: middle-center; font-size: 48px; margin-bottom: 2px; border-left-width: 0; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; height: 120px;"/>
