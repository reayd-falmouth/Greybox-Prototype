                                <ui:Button text="Credits" name="CreditsTabButton" class="modal-tab-button"/>
                            </ui:VisualElement>
                            <ui:VisualElement name="GameTabContent" class="modal-tab-content">
                                <ui:FloatField label="Move anim (s)" name="MoveAnimField" value="0.25"/>
                                <ui:IntegerField label="AI depth" name="AiDepthField" value="2"/>
                                <ui:DropdownField label="AI Engine" name="AiEngineDropdown"/>
                                <ui:Toggle label="Opponent AI" name="OpponentAiToggle" value="true"/>
                                <ui:Slider label="Game speed (s)" name="GameSpeedSlider" low-value="0.05" high-value="2" value="0.35"/>
                            </ui:VisualElement>
                            <ui:VisualElement name="AudioTabContent" class="modal-tab-content" style="display: none;">
                                <ui:Slider label="Master volume" name="MasterVolSlider" low-value="0" high-value="1" value="1"/>
                                <ui:Slider label="Music volume" name="MusicVolSlider" low-value="0" high-value="1" value="0.5"/>
                                <ui:Slider label="SFX volume" name="SfxVolSlider" low-value="0" high-value="1" value="1"/>
                            </ui:VisualElement>
                            <ui:VisualElement name="DebugTabContent" class="modal-tab-content" style="display: none;">
                                <ui:DropdownField label="Debug start position" name="DebugStartPositionDropdown"/>
