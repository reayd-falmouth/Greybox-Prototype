# =========================================================================
# Unity Standard Ignores
# =========================================================================
# This .gitignore file should be placed at the root of your Unity project directory
# Get latest from https://github.com/github/gitignore/blob/master/Unity.gitignore

[Uu]nity/[Ll]ibrary/
[Uu]nity/[Tt]emp/
[Uu]nity/[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]nity/[Uu]ser[Ss]ettings/
[Uu]nity/.idea

# MemoryCaptures can get excessive in size and could contain extremely sensitive data
/[Mm]emoryCaptures/

# Asset metadata should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# Uncomment this line if you wish to ignore the asset store tools plugin
# /[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
/[Aa]ssets/Plugins/Editor/JetBrains*

# =========================================================================
# IDEs, Compilers, and Project Formats
# =========================================================================
.vs/
.gradle/
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.booproj
*.svd
*.opendb
*.VC.db
*.vsconfig

# Text Editor / IDE Workspaces
.cursor/
Unity/.cursor/
.claude/
.continue/
.idea/
.vscode/

# =========================================================================
# Unity Generated Diagnostics, Metadata, and Artifacts
# =========================================================================
*.pidb
*.pdb
*.mdb
*.pidb.meta
*.pdb.meta
*.mdb.meta

# System information generated on crash reports
sysinfo.txt

# Automated code coverage metrics
/Unity/CodeCoverage

# Asset Recovery folder
Unity/Assets/_Recovery/

# =========================================================================
# Unity Package / Feature Architecture
# =========================================================================
# Packed Addressables Binaries
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android Assets
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# JetBrains / Rider project configuration internal syncs
Unity/.idea/.idea.Unity/.idea/projectSettingsUpdater.xml

# =========================================================================
# CI/CD and Build Outputs
# =========================================================================
# Exclude raw application compilation outputs
*.apk
*.aab
*.unitypackage

# Crashlytics execution tokens
crashlytics-build.properties

# Fastlane deployment security (CI writes Play API JSON here)
fastlane/credentials.json

# =========================================================================
# Third-Party Vendor Management & Binary Archives
# =========================================================================
# Third-party / vendor packages (not tracked; restore via Asset Store, submodule, or CI zip)
Unity/Assets/3rdParty/
Unity/Assets/3rdParty.meta
temp/
*.zip

# =========================================================================
# NEW ADDITIONS: Python, System Caches & Transient State Files
# =========================================================================
# Python compilation outputs from scripts (e.g., asmdef patcher tools)
**/__pycache__/**
*.pyc
*.pyd
*.pyi

# Local engine run tracking, workflow trace logs & diagnostics
*.log
*traceevents*
*buginfo*
*outputdata*
*buildreport*

# Local OS metadata & directory caches
.DS_Store
Thumbs.db
*.stackdump

# Unity Node & Graph Local Cache Registries (ShaderGraph / UI Builder)
*sgsubgraphdb*
*digestcache*
*.cache
*index-lock*
*.pid